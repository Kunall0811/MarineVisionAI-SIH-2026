# MarineVision AI backend configuration
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
APP_PUBLIC_URL=http://127.0.0.1:5173

# REQUIRED: put your own MongoDB Atlas URI here.
MONGODB_URI=

JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=

# Redis is used by BullMQ for sonar/AI background jobs.
REDIS_URL=

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=

# Optional SMTP. For Gmail, SMTP_HOST must be smtp.gmail.com and the password
# must be a Gmail App Password, not your normal mailbox password.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ElevenLabs - server-side only. Never put this key in Vite/frontend env.
ELEVENLABS_API_KEY=
# Default is the documented premade Rachel voice. Replace with your preferred
# female voice ID from the ElevenLabs voice library if desired.
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=
ELEVENLABS_STT_MODEL=

ONNX_MODEL_PATH=./ai-models/marine-yolo26x.onnx
AI_MODEL_VERSION=
AI_CONFIDENCE_THRESHOLD=
CESIUM_ION_TOKEN=

AUTO_SEED_DEMO=
AUTO_SEED_HISTORICAL=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_NAME=
DEMO_OPERATOR_EMAIL=
DEMO_OPERATOR_PASSWORD=
DEMO_OPERATOR_NAME=
